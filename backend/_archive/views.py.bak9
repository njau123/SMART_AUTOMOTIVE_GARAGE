# ============ PAYMENTS ============
from rest_framework.views import APIView
from rest_framework.response import Response
from apps.payments.models import Payment, PaymentAttempt

class InitiatePaymentView(APIView):
    permission_classes = [IsAuthenticated]

    def post(self, request):
        amount = request.data.get('amount')
        reference = f"PAY-{uuid.uuid4().hex[:8].upper()}"
        # Simulate Selcom sandbox
        payment = Payment.objects.create(
            user=request.user,
            amount=amount,
            provider='SELCOM',
            status='PENDING',
            external_reference=reference
        )
        return Response({
            'success': True,
            'message': 'Payment initiated',
            'data': {
                'reference': reference,
                'amount': amount,
                'status': 'PENDING',
                'instructions': 'Dial *150*01# and enter code',
                'code': '123456'  # Simulated
            }
        })

class VerifyPaymentView(APIView):
    permission_classes = [IsAuthenticated]

    def get(self, request, reference):
        try:
            payment = Payment.objects.get(external_reference=reference)
            # Simulate verification
            payment.status = 'COMPLETED'
            payment.save()
            return Response({
                'success': True,
                'message': 'Payment verified',
                'data': {'status': 'COMPLETED'}
            })
        except Payment.DoesNotExist:
            return Response({'success': False, 'message': 'Payment not found'}, status=404)
# ============ NOTIFICATIONS ============
from apps.notifications.models import NotificationDevice

class RegisterDeviceView(APIView):
    permission_classes = [IsAuthenticated]

    def post(self, request):
        fcm_token = request.data.get('fcm_token')
        device = request.data.get('device', 'web')
        if fcm_token:
            NotificationDevice.objects.update_or_create(
                user=request.user,
                fcm_token=fcm_token,
                defaults={'device': device}
            )
            return Response({'success': True, 'message': 'Device registered'})
        return Response({'success': False, 'message': 'FCM token required'}, status=400)
