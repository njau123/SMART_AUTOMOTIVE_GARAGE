    queryset = DTCCode.objects.all()
    serializer_class = DTCCodeSerializer
    permission_classes = [IsAuthenticated]

class DiagnosisViewSet(viewsets.ModelViewSet):
    queryset = DiagnosisSession.objects.all()
    permission_classes = [IsAuthenticated]
